# ---- General ----
APP_NAME="Dynadot Domain Service"
ENVIRONMENT=local            # local | dev | staging | prod
DEBUG=false
SECRET_KEY=change-me-in-production

# ---- Database ----
# Production (PostgreSQL, async driver):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dynadot_bot
DATABASE_URL=sqlite+aiosqlite:///./dynadot_bot.db
DB_ECHO=false

# ---- i18n ----
DEFAULT_LANGUAGE=ru
SUPPORTED_LANGUAGES=ru,en

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TMA_URL=https://your-tma-domain.example
# Leave empty to run the bot via long polling (`python -m app.bot`).
# Set it to your public HTTPS base URL to serve updates over the webhook route.
TELEGRAM_WEBHOOK_BASE_URL=
TELEGRAM_WEBHOOK_PATH=/api/v1/webhooks/telegram
TELEGRAM_ADMIN_IDS=
SUPPORT_USERNAME=

# ---- Dynadot (RESTful v2) ----
# Sandbox is pre-funded with 10,000 in every currency.
DYNADOT_BASE_URL=https://api-sandbox.dynadot.com
# Production: https://api.dynadot.com
DYNADOT_API_KEY=
DYNADOT_API_SECRET=
# Regular price level = 1 concurrent request, 60/min. Raise only for Bulk plans.
DYNADOT_MAX_CONCURRENCY=1
DYNADOT_RATE_LIMIT_PER_MINUTE=60
DYNADOT_MAX_RETRIES=4

# ---- Pricing ----
DEFAULT_MARKUP_PERCENT=25
USD_TO_RUB_RATE=95

# --- Registration worker -----------------------------------------------
# Run the worker inside the API process. Keep false when `python -m app.worker`
# runs as its own service: two workers contend for the same tasks and waste
# Dynadot's single request slot.
REGISTRATION_WORKER_ENABLED=false
REGISTRATION_WORKER_INTERVAL=5
REGISTRATION_MAX_ATTEMPTS=4

# ---- Payments ----
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=
PLATEGA_BASE_URL=https://app.platega.io
PLATEGA_TIMEOUT_SECONDS=20
# Platega method selector: 1 = card, 2 = SBP QR, 13 = crypto.
PLATEGA_PAYMENT_METHOD=2
PAYMENT_RETURN_URL=
PAYMENT_FAILED_URL=
